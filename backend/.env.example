# Copy to your hosting provider's environment settings for production.
# Development needs none of these.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=api.mechmark.in
CORS_ALLOWED_ORIGINS=https://mechmark.in,https://www.mechmark.in
CSRF_TRUSTED_ORIGINS=https://api.mechmark.in

# Enquiry notification emails (e.g. Gmail SMTP with an app password)
ENQUIRY_NOTIFY_EMAILS=mechmarks3@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Frontend (Vercel): point the React site at the backend
# VITE_API_URL=https://api.mechmark.in
